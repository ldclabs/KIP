// --- DEFINE the "consolidated_to" predicate: Event | Experience -> semantic knowledge ---
UPSERT {
  CONCEPT ?consolidated_to_prop_def {
    {type: "$PropositionType", name: "consolidated_to"}
    SET ATTRIBUTES {
      description: "Links an Event or Experience to a durable semantic concept (e.g., Preference or domain fact) extracted during Formation or Maintenance. Use the more specific 'derived_insight' for Experience -> Insight and 'compiled_to' for Experience -> Skill. The reverse provenance link is 'derived_from'.",
      subject_types: ["Event", "Experience"],
      object_types: ["*"],
      is_symmetric: false,
      is_transitive: false
    }
    SET PROPOSITIONS {
      ("belongs_to_domain", {type: "Domain", name: "CoreSchema"})
    }
  }
}
WITH METADATA {
  source: "SystemBootstrap",
  author: "$system",
  confidence: 1.0,
  status: "active"
}
