{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KIP",
  "scopeName": "source.kip",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#number"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#null"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#parameter"
    },
    {
      "include": "#function"
    },
    {
      "include": "#keyword-compound"
    },
    {
      "include": "#keyword-element"
    },
    {
      "include": "#keyword-statement"
    },
    {
      "include": "#keyword-modifier"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.kip",
      "match": "//.*$"
    },
    "string": {
      "name": "string.quoted.double.kip",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.kip"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.kip"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.kip",
          "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "number": {
      "name": "constant.numeric.kip",
      "match": "-?\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
    },
    "boolean": {
      "comment": "JSON literals, not protocol keywords: these stay case-sensitive.",
      "name": "constant.language.boolean.kip",
      "match": "\\b(true|false)\\b"
    },
    "null": {
      "name": "constant.language.null.kip",
      "match": "\\bnull\\b"
    },
    "variable": {
      "name": "variable.other.kip",
      "match": "\\?[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "parameter": {
      "name": "variable.parameter.kip",
      "comment": "A placeholder occupies a full value position, so it never directly follows an identifier/quote/closing bracket (that colon is a key separator).",
      "match": "(?<![A-Za-z0-9_\"'\\]\\})]):[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "function": {
      "comment": "Function names are ASCII case-insensitive, like every other KIP 2.0 name. The guards keep `?a.count` and `{in: 1}` out.",
      "name": "support.function.kip",
      "match": "(?i)(?<![\\w.])(?:COUNT|SUM|AVG|MIN|MAX|DISTINCT|CONTAINS|STARTS_WITH|ENDS_WITH|REGEX|IN|IS_NULL|IS_NOT_NULL|IS_LITERAL|IS_ELEMENT|IS_KIND|LITERAL_TYPE|ADD|MUL|CLAMP|COALESCE)\\b(?!:)"
    },
    "keyword-compound": {
      "comment": "Two- and three-word keywords, highlighted as one unit. Listed before the single-word rules so the longer spelling wins.",
      "patterns": [
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSET\\s+FIELDS\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSET\\s+ATTRIBUTES\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSET\\s+FACET\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSET\\s+STRUCTURAL\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSET\\s+RETENTION\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bUNSET\\s+ATTRIBUTES\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bUNSET\\s+FACET\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bCLIENT\\s+KEY\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bEXPECT\\s+VERSION\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bEXPECT\\s+STATE\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bAS\\s+OF\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bFOR\\s+TIME\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bWITH\\s+EPISTEMIC\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bWITH\\s+TYPE\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bWITH\\s+PREDICATE\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bORDER\\s+BY\\b"
        },
        {
          "name": "storage.type.kip",
          "match": "(?i)\\bBELIEF\\s+SLOT\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bREFERENCE\\s+POLICY\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bBY\\s+IDEMPOTENCY\\s+KEY\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSTRUCTURAL\\s+FIELDS?\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSCHEMA\\s+ENVIRONMENT\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bSCHEMA\\s+PACKAGES?\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bEXECUTION\\s+CONTEXT\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bEPISTEMIC\\s+(?:POLICIES|POLICY)\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bPROJECTION\\s+CAPABILITY\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bIMPORT\\s+CAPSULE\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bIMPORT\\s+PLAN\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bFROM\\s+SEQ\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bTO\\s+SEQ\\b"
        },
        {
          "name": "keyword.other.kip",
          "match": "(?i)\\bAFTER\\s+SEQ\\b"
        },
        {
          "name": "keyword.control.kip",
          "match": "(?i)\\bCHANGES\\s+SINCE\\b"
        },
        {
          "name": "keyword.control.kip",
          "match": "(?i)\\bHISTORY\\s+ELEMENT\\b"
        },
        {
          "name": "keyword.control.kip",
          "match": "(?i)\\bHISTORY\\s+SPACE\\b"
        },
        {
          "name": "keyword.control.kip",
          "match": "(?i)\\bPREVIEW\\s+KML\\b"
        },
        {
          "name": "keyword.control.kip",
          "match": "(?i)\\bVALIDATE\\s+(?:KQL|KML)\\b"
        }
      ]
    },
    "keyword-element": {
      "comment": "The five Core element kinds plus the Projection pattern kinds and CAPSULE.",
      "name": "storage.type.kip",
      "match": "(?i)(?<![\\w.])(?:CONCEPT|PROPOSITION|ASSERTION|EVIDENCE|ACTIVITY|STRUCTURAL|BELIEF|SLOT|CAPSULE)\\b(?!:)"
    },
    "keyword-statement": {
      "comment": "Statement verbs and clause heads of KQL, KML and META. Keywords are ASCII case-insensitive; the lookbehind keeps `?a.find` and the negative lookahead keeps `{by: ...}` uncolored, since keywords are contextual, not reserved.",
      "name": "keyword.control.kip",
      "match": "(?i)(?<![\\w.])(?:FIND|MUTATE|CREATE|UPSERT|ENSURE|ASSERT|SUPERSEDING|SUPERSEDE|UPDATE|RETRACT|CORRECT|TRANSITION|ARCHIVE|TOMBSTONE|PURGE|MERGE|DESCRIBE|LIST|SEARCH|VERIFY|VALIDATE|PREVIEW|HISTORY|CHANGES|SNAPSHOT|EXPORT|WHERE|FILTER|NOT|OPTIONAL|UNION)\\b(?!:)"
    },
    "keyword-modifier": {
      "comment": "Clause modifiers and operand keywords. Plural spellings precede their singular prefix so the longer one wins.",
      "name": "keyword.other.kip",
      "match": "(?i)(?<![\\w.])(?:ASC|AS|OF|SEQ|TX|TIME|FOR|EPISTEMIC|ORDER|BY|DESC|LIMIT|CURSOR|SET|UNSET|RETENTION|CONFIRM|REFERENCE|POLICIES|POLICY|INTO|TO|TYPES|TYPE|CLIENT|KEY|NAME|MATCH|FIELDS|FIELD|ATTRIBUTES|FACETS|FACET|EXPECT|VERSION|STATE|STATUS|WITH|MODE|THRESHOLD|PRIMER|PROTOCOL|EXECUTION|CONTEXT|CAPABILITIES|CAPABILITY|SPACES|SPACE|SCHEMA|ENVIRONMENT|PACKAGES|PACKAGE|PREDICATES|PREDICATE|COMPATIBILITY|FROM|ERROR|TRANSACTION|IDEMPOTENCY|PROJECTION|TRUST|ACCESS|COGNITION|RECEIPT|BLOB|CHECKPOINT|KQL|KML|IMPORT|PLAN|ELEMENT|SINCE|AFTER)\\b(?!:)"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.kip",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.kip",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.kip",
          "match": "-"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.kip",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.kip",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.kip",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.kip",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.kip",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.kip",
          "match": "\\]"
        },
        {
          "name": "punctuation.separator.comma.kip",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.kip",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.kip",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.pipe.kip",
          "match": "\\|"
        }
      ]
    }
  }
}
