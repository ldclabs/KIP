{
  "name": "vscode-kip",
  "displayName": "KIP Language",
  "description": "Language support for KIP (Knowledge Interaction Protocol) v1.0-RC10: syntax highlighting, formatting, diagnostics, and code folding for .kip files",
  "version": "0.4.0",
  "publisher": "ldclabs",
  "license": "MIT",
  "keywords": [
    "kip",
    "knowledge-graph",
    "kql",
    "kml",
    "formatter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ldclabs/KIP",
    "directory": "packages/vscode-kip"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [],
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kip",
        "aliases": [
          "KIP",
          "kip"
        ],
        "extensions": [
          ".kip"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[kip]": {
        "editor.defaultFormatter": "ldclabs.vscode-kip"
      }
    },
    "grammars": [
      {
        "language": "kip",
        "scopeName": "source.kip",
        "path": "./syntaxes/kip.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "package": "vsce package --no-dependencies",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@ldclabs/kip-lang": "workspace:*"
  }
}
