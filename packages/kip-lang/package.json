{
  "name": "@ldclabs/kip-lang",
  "version": "2.0.1",
  "description": "Language toolkit for KIP 2.0 (Knowledge Interaction Protocol): lexer, parser, formatter, diagnostics, and lowering of KQL/KML/META to the executable AST",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "kip": {
    "specRevision": "2.0-draft",
    "scope": "command-text-toolkit",
    "conformanceProfiles": [],
    "syntaxSurfaces": [
      "KIP-KQL",
      "KIP-KML",
      "KIP-META"
    ]
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "kip",
    "kql",
    "kml",
    "meta",
    "knowledge-graph",
    "agent-memory",
    "cognitive-nexus",
    "parser",
    "formatter",
    "lexer"
  ],
  "author": "LDC Labs",
  "license": "MIT",
  "homepage": "https://github.com/ldclabs/KIP/tree/main/packages/kip-lang#readme",
  "bugs": {
    "url": "https://github.com/ldclabs/KIP/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldclabs/KIP.git",
    "directory": "packages/kip-lang"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
