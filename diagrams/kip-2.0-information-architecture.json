  "cards": [
    {
      "dot": "cyan",
      "title": "Three questions kept apart",
      "items": [
        "Meaning — what can be represented",
        "Belief — what the Brain currently accepts",
        "Authority — who may read, write, or elevate"
      ]
    },
    {
      "dot": "emerald",
      "title": "Write once, never rewrite",
      "items": [
        "Observed payloads enter Evidence from the transport envelope, never re-typed by the model",
        "Correction is a new Assertion plus supersession, never an edit",
        "Reading never reinforces memory or raises confidence"
      ]
    },
    {
      "dot": "violet",
      "title": "Attention, then forgetting",
      "items": [
        "Proactivity is a state differential: Change Envelopes meet armed Watch conditions, not a timer",
        "LIST DEPENDENTS makes cognition downstream of a revised root reviewable",
        "PURGE PAYLOAD destroys observed bytes while the Evidence record, digest, and citations survive"
      ]
    }
