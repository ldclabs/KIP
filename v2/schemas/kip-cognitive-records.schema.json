    "RecallCoverage": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "object",
          "properties": {
            "space_id": {
              "type": "string",
              "minLength": 1
            },
            "snapshot_seq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "schema_environment_version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "identity_version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "policy": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "trust_version": {
              "type": "string",
              "minLength": 1
            },
            "authorization_view": {
              "type": "string",
              "minLength": 1
            },
            "context_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "risk": {
              "type": "string",
              "minLength": 1
            },
            "valid_at": {
              "type": "string",
              "minLength": 1,
              "format": "date-time"
            },
            "next_invalid_at": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "space_id",
            "snapshot_seq",
            "schema_environment_version",
            "identity_version",
            "policy",
            "trust_version",
            "authorization_view",
            "context_refs",
            "purpose",
            "risk",
            "valid_at",
            "next_invalid_at"
          ],
          "additionalProperties": false
        },
        "channels": {
          "type": "object",
          "required": [
            "constraints",
            "commitments",
            "dependencies",
            "failures",
            "experiences",
            "skills",
            "evidence"
          ],
          "additionalProperties": {
            "type": "object",
            "properties": {
              "completed": {
                "type": "boolean"
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "completed",
              "truncated"
            ],
            "additionalProperties": false
          }
        },
        "unverified_preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "action_eligible": {
          "type": "boolean"
        }
      },
      "required": [
        "basis",
        "channels",
        "unverified_preconditions",
        "action_eligible"
      ],
      "additionalProperties": false
    },
    "ErasurePlan": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "payload_only",
            "semantic_forgetting"
          ]
        },
        "basis_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "surface": {
                "type": "string",
                "enum": [
                  "element",
                  "payload",
                  "summary",
                  "replay",
                  "index",
                  "cache",
                  "blob",
                  "backup"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "erased",
                  "held",
                  "unavailable"
                ]
              }
            },
            "required": [
              "ref",
              "surface",
              "state"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "external_exports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "completed",
            "partial",
            "blocked"
          ]
        },
        "receipts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "scope",
        "basis_seq",
        "source_event_refs",
        "targets",
        "external_exports",
        "status",
        "receipts"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            }
          },
          "then": {
            "properties": {
              "targets": {
                "items": {
                  "properties": {
                    "state": {
                      "const": "erased"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
