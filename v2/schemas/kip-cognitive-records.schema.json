        },
        "extractor_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "preserved_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "known_omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "reencoding_eligible": {
          "type": "boolean"
        }
      },
      "required": [
        "source_refs",
        "extractor_version",
        "schema_version",
        "preserved_fields",
        "known_omissions",
        "reencoding_eligible"
      ],
      "additionalProperties": false
