{
  "format": "KIP-Schema-Package",
  "format_version": "2.0-draft",
  "manifest": {
    "package_id": "kip://profiles/cognitive-memory",
    "version": "2.0.0",
    "package_ref": "kip://profiles/cognitive-memory@2.0.0",
    "name": "KIP Cognitive Memory Profile",
    "description": "Standard portable memory ontology for KIP 2.0 Brains.",
    "publisher": "urn:kip:publisher:ldclabs",
    "purpose": "standard_profile",
    "stability": "profile_candidate",
    "executable": false,
    "source_document": "profiles/CognitiveMemoryProfile-2.0.md"
  },
  "dependencies": [
    {
      "package_id": "kip://core",
      "version": "2.0.0",
      "package_ref": "kip://core@2.0.0",
      "required": true
    }
  ],
  "definitions": {
    "concept_types": {
      "Person": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/Person",
        "kind": "ConceptType",
        "description": "Semantic person/actor used in cognitive content; never an authenticated Principal or ActorBinding.",
        "attributes": {
          "open": true,
          "fields": {
            "display_name": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "aliases": {
              "type": "array",
              "required": false,
              "mutable": true
            },
            "description": {
              "type": "string",
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "authority_invariant": "Person != PrincipalRecord != ActorBinding"
        }
      },
      "Event": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/Event",
        "kind": "ConceptType",
        "description": "Compact episodic anchor describing what happened in a bounded situation.",
        "attributes": {
          "open": true,
          "fields": {
            "event_class": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "summary": {
              "type": "string",
              "required": true,
              "mutable": true
            },
            "started_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "ended_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "outcome_status": {
              "type": "string",
              "required": false,
              "mutable": true,
              "enum": [
                "success",
                "partial",
                "failure",
                "aborted",
                "unknown"
              ]
            },
            "outcome_summary": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "context_summary": {
              "type": "string",
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "question": "What happened?",
          "evidence_invariant": "Event summary is not independent Evidence."
        }
      },
      "Experience": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/Experience",
        "kind": "ConceptType",
        "description": "Bounded goal-directed trajectory through state, action, observation, feedback, and outcome.",
        "attributes": {
          "open": true,
          "fields": {
            "experience_class": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "goal": {
              "type": "string",
              "required": true,
              "mutable": true
            },
            "initial_state_summary": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "outcome_status": {
              "type": "string",
              "required": true,
              "mutable": true,
              "enum": [
                "success",
                "partial",
                "failure",
                "aborted",
                "unknown"
              ]
            },
            "outcome_summary": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "started_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "ended_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "step_count": {
              "type": "integer",
              "required": false,
              "mutable": true,
              "minimum": 0
            },
            "surprise": {
              "type": "number",
              "required": false,
              "mutable": true,
              "minimum": 0.0,
              "maximum": 1.0
            },
            "learning_value": {
              "type": "number",
              "required": false,
              "mutable": true,
              "minimum": 0.0,
              "maximum": 1.0
            },
            "consolidation_status": {
              "type": "string",
              "required": false,
              "mutable": true,
              "enum": [
                "pending",
                "semantic",
                "procedural",
                "completed",
                "archived"
              ]
            }
          }
        },
        "model_hints": {
          "question": "What path was traversed while pursuing a goal?",
          "avoid": [
            "Do not store hidden chain-of-thought."
          ],
          "formation_signals": [
            "multi-step goal pursuit",
            "failure/recovery",
            "prediction error",
            "strategy revision",
            "corrective feedback",
            "novel procedure",
            "counterexample"
          ]
        }
      },
      "ExperienceStep": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/ExperienceStep",
        "kind": "ConceptType",
        "description": "One ordered externally representable step of an Experience trajectory.",
        "attributes": {
          "open": true,
          "fields": {
            "step_kind": {
              "type": "string",
              "required": true,
              "mutable": true,
              "enum": [
                "context",
                "observation",
                "decision",
                "action",
                "feedback",
                "belief_update"
              ]
            },
            "summary": {
              "type": "string",
              "required": true,
              "mutable": true
            },
            "timestamp": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "tool": {
              "type": [
                "string",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "result_status": {
              "type": [
                "string",
                "null"
              ],
              "required": false,
              "mutable": true,
              "enum": [
                "success",
                "partial",
                "failure",
                "aborted",
                "unknown",
                null
              ]
            },
            "expected_observation": {
              "type": [
                "string",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "actual_observation": {
              "type": [
                "string",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "decision_summary": {
              "type": [
                "string",
                "null"
              ],
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "privacy_invariant": "decision_summary may store concise reusable rationale but never requires hidden chain-of-thought.",
          "ordering_invariant": "Step order lives on the ordered has_step Structural References (virtual edge index); causality requires an explicit caused_by Proposition + Assertion."
        }
      },
      "Preference": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/Preference",
        "kind": "ConceptType",
        "description": "Mutable summary artifact for a relatively stable preference pattern; truth-sensitive preference claims remain Proposition + Assertion + Evidence.",
        "attributes": {
          "open": true,
          "fields": {
            "scope": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "strength": {
              "type": "number",
              "required": false,
              "mutable": true,
              "minimum": 0.0,
              "maximum": 1.0
            },
            "stability": {
              "type": "number",
              "required": false,
              "mutable": true,
              "minimum": 0.0,
              "maximum": 1.0
            },
            "first_observed_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "last_observed_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "counterexample_count": {
              "type": "integer",
              "required": false,
              "mutable": true,
              "minimum": 0
            }
          }
        },
        "model_hints": {
          "history_invariant": "Preference summary does not replace source Assertion/Evidence history."
        }
      },
      "Insight": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/Insight",
        "kind": "ConceptType",
        "description": "Declarative lesson derived from Evidence or Experience.",
        "attributes": {
          "open": true,
          "fields": {
            "summary": {
              "type": "string",
              "required": true,
              "mutable": true
            },
            "scope": {
              "type": "string",
              "required": false,
              "mutable": true
            },
            "created_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "epistemic_invariant": "If truth-apt, also represent the reusable claim through Proposition + Assertion."
        }
      },
      "Commitment": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/Commitment",
        "kind": "ConceptType",
        "description": "Prospective memory artifact for an obligation, promise, reminder, follow-up, or intended future action.",
        "attributes": {
          "open": true,
          "fields": {
            "summary": {
              "type": "string",
              "required": true,
              "mutable": true
            },
            "status": {
              "type": "string",
              "required": true,
              "mutable": true,
              "enum": [
                "pending",
                "fulfilled",
                "cancelled",
                "expired",
                "blocked"
              ]
            },
            "created_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "due_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "completed_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "priority": {
              "type": [
                "number",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "conditions": {
              "type": [
                "string",
                "array",
                "object",
                "null"
              ],
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "temporal_invariant": "due_at != retention.expires_at",
          "authority_invariant": "Commitment does not automatically schedule or authorize an external action."
        }
      },
      "Skill": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/Skill",
        "kind": "ConceptType",
        "description": "Reusable procedural cognition compiled from Experience, Evidence, or validated instruction.",
        "attributes": {
          "open": true,
          "fields": {
            "skill_class": {
              "type": "string",
              "required": true,
              "mutable": true,
              "enum": [
                "heuristic",
                "workflow",
                "checklist",
                "tool_policy",
                "communication_strategy",
                "diagnostic",
                "recovery",
                "prompt_pattern",
                "code_pattern",
                "subagent_pattern"
              ]
            },
            "summary": {
              "type": "string",
              "required": true,
              "mutable": true
            },
            "applicability": {
              "type": [
                "string",
                "array",
                "object"
              ],
              "required": false,
              "mutable": true
            },
            "preconditions": {
              "type": [
                "string",
                "array",
                "object"
              ],
              "required": false,
              "mutable": true
            },
            "procedure": {
              "type": [
                "string",
                "array",
                "object"
              ],
              "required": true,
              "mutable": true
            },
            "success_criteria": {
              "type": [
