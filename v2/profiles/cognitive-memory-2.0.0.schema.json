            },
            "review_after": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "authority_invariant": "Semantic assignment, including to $system, does not grant Principal permission."
        }
      },
      "SelfModel": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/SelfModel",
        "kind": "ConceptType",
        "description": "Derived cognition describing the Brain/agent's model of its own identity, capabilities, limitations, values, preferences, habits, relationships, and goals.",
        "attributes": {
          "open": true,
          "fields": {
            "summary": {
              "type": "string",
              "required": true,
              "mutable": true
            },
            "identity_summary": {
              "type": [
                "string",
                "object",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "capabilities": {
              "type": [
                "array",
