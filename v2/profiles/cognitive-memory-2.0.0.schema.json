              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "authority_invariant": "SelfModel is descriptive cognition, never Governance or Principal identity."
        }
      }
    },
    "predicates": {
      "prefers": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/prefers",
        "kind": "PredicateType",
        "description": "Subject holds a relatively stable preference for the object. Truth-sensitive: use Proposition + Assertion + Evidence, not a bare attribute.",
        "subject": {
          "concept_types": [
            "kip://profiles/cognitive-memory@2.0.0/Person"
          ]
        },
        "object": {
          "kinds": [
            "Concept"
          ]
        },
        "functional": false,
        "open_world": true,
        "complete": false
      },
      "caused_by": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/caused_by",
        "kind": "PredicateType",
        "description": "Effect-to-cause claim between ExperienceSteps: the subject step's outcome/observation was causally produced by the object step. Direction is effect -> cause. This is a truth-sensitive semantic claim (Proposition + Assertion, typically mode observed/inferred with Evidence), never structural topology; step order alone must not be promoted into caused_by.",
        "subject": {
          "concept_types": [
            "kip://profiles/cognitive-memory@2.0.0/ExperienceStep"
          ]
        },
        "object": {
          "concept_types": [
            "kip://profiles/cognitive-memory@2.0.0/ExperienceStep"
          ]
        },
        "functional": false,
        "open_world": true,
        "complete": false
      },
      "same_as": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/same_as",
        "kind": "PredicateType",
        "description": "Unverified identity claim: subject and object are believed to denote the same real-world entity. Feeds identity review; it never auto-merges Concepts and never establishes canonical_id by itself.",
        "subject": {
          "kinds": [
            "Concept"
          ]
        },
        "object": {
          "kinds": [
            "Concept"
          ]
        },
        "functional": false,
        "open_world": true,
        "complete": false
      }
    },
    "facets": {
      "MnemonicState": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/MnemonicState",
        "kind": "FacetDefinition",
        "description": "Mutable mnemonic accessibility/importance state, separate from epistemic confidence and trust.",
        "closed": true,
        "applicable_to": {
          "kinds": [
            "Concept"
          ]
        },
        "fields": {
          "memory_strength": {
            "type": "number",
            "required": false,
            "mutable": true,
            "minimum": 0.0,
            "maximum": 1.0
          },
          "salience": {
            "type": "number",
            "required": false,
            "mutable": true,
            "minimum": 0.0,
            "maximum": 1.0
          },
          "last_metabolized_at": {
            "type": [
              "timestamp",
              "null"
            ],
            "required": false,
            "mutable": true
          }
        },
        "model_hints": {
          "invariants": [
            "memory_strength != Assertion confidence",
            "salience != source trust",
            "Facet state cannot override Core/Governance fields"
          ]
        }
      },
      "SkillUtility": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/SkillUtility",
        "kind": "FacetDefinition",
        "description": "Mutable empirical/procedural usefulness state for Skill; not epistemic probability or authority.",
        "closed": true,
        "applicable_to": {
          "concept_types": [
            "kip://profiles/cognitive-memory@2.0.0/Skill"
          ]
        },
        "fields": {
          "utility": {
            "type": "number",
            "required": false,
            "mutable": true,
            "minimum": 0.0,
            "maximum": 1.0
          },
          "success_count": {
            "type": "integer",
            "required": false,
            "mutable": true,
            "minimum": 0
          },
          "failure_count": {
            "type": "integer",
            "required": false,
            "mutable": true,
            "minimum": 0
          },
          "last_validated_at": {
            "type": [
              "timestamp",
              "null"
            ],
            "required": false,
            "mutable": true
          }
        },
        "model_hints": {
          "authority_invariant": "High utility != executable authority."
        }
      }
    },
