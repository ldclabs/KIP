                "array",
                "object"
              ],
              "required": false,
              "mutable": true
            },
            "failure_modes": {
              "type": [
                "array",
                "object"
              ],
              "required": false,
              "mutable": true
            },
            "counterexamples": {
              "type": [
                "array",
                "object"
              ],
              "required": false,
              "mutable": true
            },
            "recovery": {
              "type": [
                "string",
                "array",
                "object"
              ],
              "required": false,
              "mutable": true
            },
            "status": {
              "type": "string",
              "required": true,
              "mutable": true,
              "enum": [
                "candidate",
                "validated",
                "needs_review",
                "deprecated",
                "archived"
              ]
            },
            "created_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            },
            "last_validated_at": {
              "type": [
                "timestamp",
                "null"
              ],
              "required": false,
              "mutable": true
            }
          }
        },
        "model_hints": {
          "authority_invariant": "Validated Skill != executable authority."
        }
      },
      "SleepTask": {
        "ref": "kip://profiles/cognitive-memory@2.0.0/SleepTask",
        "kind": "ConceptType",
        "description": "Durable maintenance work item for a Brain maintenance process.",
        "attributes": {
          "open": true,
          "fields": {
            "task_class": {
              "type": "string",
              "required": true,
              "mutable": true,
              "enum": [
                "consolidate",
                "review_conflict",
                "review_skill",
                "resolve_identity",
                "review_retention",
                "refresh_self_model",
                "inspect_quarantine"
              ]
