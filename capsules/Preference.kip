// --- DEFINE the "Preference" concept type and "prefers" predicate ---
UPSERT {
    CONCEPT ?preference_type_def {
        {type: "$ConceptType", name: "Preference"}
        SET ATTRIBUTES {
            description: "Represents a first-class stable preference fact in the graph: some subject reliably prefers something. Use `Preference` when the preference should be queryable, shareable, supported by evidence across Events, or evolve over time.",
            display_hint: "⭐",
            instance_schema: {
                "description": {
                    "type": "string",
                    "is_required": true,
                    "description": "A concise statement of the preference (e.g., 'Prefers dark mode in all apps')."
                },
                "category": {
                    "type": "string",
                    "is_required": false,
                    "description": "The domain or class of the preference (e.g., 'UI', 'food', 'communication_style', 'programming_language'). Used to detect mutually exclusive preferences within the same category."
                },
                "evidence_count": {
                    "type": "number",
                    "is_required": false,
                    "description": "The number of independent Events or Experiences supporting this preference. Updated during consolidation. Epistemic support lives in metadata.confidence on the 'prefers' assertion link; retention and retrieval availability live separately in metadata.memory_strength. Reinforcement and time-based decay primarily update memory_strength, while confirming or contradicting evidence may update confidence."
                },
                "first_observed": {
                    "type": "string",
                    "is_required": false,
                    "description": "ISO 8601 timestamp of the earliest Event or Experience from which this preference was derived."
                },
                "last_observed": {
                    "type": "string",
                    "is_required": false,
                    "description": "ISO 8601 timestamp of the most recent Event or Experience confirming this preference."
                },
                "source_event": {
                    "type": "string",
                    "is_required": false,
                    "description": "Legacy convenience field containing the name of the original Event. New writes should use source_memory or the structural 'derived_from' proposition."
                },
                "source_memory": {
                    "type": "string",
                    "is_required": false,
                    "description": "Name of the original Event or Experience from which this preference was first derived. For multiple sources, use structural 'derived_from' propositions instead."
                }
            }
        }
        SET PROPOSITIONS {
            ("belongs_to_domain", {type: "Domain", name: "CoreSchema"})
        }
    }

    // Define the "prefers" predicate: Person → Preference
    CONCEPT ?prefers_prop_def {
        {type: "$PropositionType", name: "prefers"}
        SET ATTRIBUTES {
            description: "Connects a Person to a graph-level `Preference` concept. Use this relation when the preference should participate in graph querying, provenance tracking, evidence aggregation, or temporal evolution. When a preference changes, the old proposition should be marked with superseded metadata rather than deleted.",
            object_types: ["Preference"],
            subject_types: ["Person"]
        }
        SET PROPOSITIONS {
            ("belongs_to_domain", {type: "Domain", name: "CoreSchema"})
        }
    }
}
WITH METADATA {
    source: "SystemBootstrap",
    author: "$system",
    confidence: 1.0,
    status: "active"
}
