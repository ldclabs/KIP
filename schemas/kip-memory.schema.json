        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "raised_seq": {
          "$ref": "#/$defs/Sequence",
          "description": "The space_seq of the commit that raised this item (the watch_fire or commitment_review Activity). Several items can share one raised_seq; attention recall orders by (raised_seq, ref)."
