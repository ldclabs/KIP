{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kip:2.0:schema:common",
  "$defs": {
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "Ref": {
      "type": "string",
      "minLength": 1
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ArtifactPin": {
      "type": "object",
      "properties": {
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "content_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "artifact_ref",
        "content_digest"
      ],
      "additionalProperties": false
    },
    "TimeBound": {
      "type": "object",
      "description": "An instant known only within [earliest, latest] (Spec §25.5). At least one bound; earliest <= latest is a semantic check.",
      "properties": {
        "earliest": {
          "$ref": "#/$defs/Timestamp"
        },
        "latest": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "TimePoint": {
      "description": "A valid_time endpoint: an exact Timestamp, a TimeBound, or null (Spec §13.2, §25.2).",
      "anyOf": [
        {
          "$ref": "#/$defs/Timestamp"
        },
        {
          "$ref": "#/$defs/TimeBound"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
