{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kip:2.0:schema:projection",
  "$defs": {
    "ProjectionBasis": {
      "type": "object",
      "properties": {
        "space_id": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schema_environment_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "identity_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version"
          ],
          "additionalProperties": false
        },
        "trust_version": {
          "type": "string",
          "minLength": 1
        },
        "authorization_view": {
          "type": "string",
          "minLength": 1
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "valid_at": {
          "$ref": "urn:kip:2.0:schema:common#/$defs/Timestamp"
        },
        "next_invalid_at": {
          "anyOf": [
            {
              "$ref": "urn:kip:2.0:schema:common#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "space_id",
        "snapshot_seq",
        "schema_environment_version",
        "identity_version",
        "policy",
        "trust_version",
        "authorization_view",
        "context_refs",
        "purpose",
        "risk",
        "valid_at",
        "next_invalid_at"
      ],
      "additionalProperties": false
    },
    "DependencyValidity": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "current",
            "needs_review",
            "unverifiable"
          ]
        },
        "action_eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "basis": {
          "$ref": "urn:kip:2.0:schema:projection#/$defs/ProjectionBasis"
        }
      },
      "required": [
        "status",
        "action_eligible",
        "reasons",
        "basis"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "needs_review",
                  "unverifiable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "action_eligible": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "Projection": {
      "type": "object",
      "properties": {
        "proposition_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "contested",
            "uncertain",
            "insufficient"
          ]
        },
        "candidate_status": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "contested",
            "uncertain",
            "insufficient"
          ]
        },
        "slot_status": {
          "type": "string",
          "enum": [
            "accepted",
            "contested",
            "uncertain",
            "insufficient"
          ]
        },
        "leading": {
          "type": "string",
          "enum": [
            "support",
            "opposition",
            "none"
          ]
        },
        "basis": {
          "$ref": "urn:kip:2.0:schema:projection#/$defs/ProjectionBasis"
        },
        "conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "conflict_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "dependency_validity": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "current",
                "needs_review",
                "unverifiable"
              ]
            },
            "action_eligible": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "basis": {
              "$ref": "urn:kip:2.0:schema:projection#/$defs/ProjectionBasis"
            }
          },
          "required": [
            "status",
            "action_eligible",
            "reasons",
            "basis"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "needs_review",
                      "unverifiable"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "action_eligible": {
                    "const": false
                  }
                }
              }
            }
          ]
        },
        "support": {
          "type": "object",
          "properties": {
            "assertion_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "root_groups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "assertion_ids",
            "root_groups"
          ],
          "additionalProperties": true
        },
        "opposition": {
          "type": "object",
          "properties": {
            "assertion_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "root_groups": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            }
          },
          "required": [
            "assertion_ids",
            "root_groups"
          ],
          "additionalProperties": true
        },
        "explanation": {
          "type": "object"
        },
        "uncertainty": {
          "type": "object",
          "properties": {
            "level": {
              "type": [
                "string",
                "null"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Includes temporal_indeterminate (Spec §25.5) and outranked (Spec §21.13) where they apply."
            }
          },
          "additionalProperties": false
        },
        "precedence": {
          "type": "object",
          "description": "Present when a policy precedence rule decided this candidate's final status (Spec §21.13).",
          "properties": {
            "rule": {
              "enum": [
                "context_specificity",
                "first_person_testimony",
                "recency"
              ]
            },
            "prevailed_over": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "outranked_by": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "rule"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "candidate_status",
        "slot_status",
        "leading",
        "basis",
        "conflict_refs",
        "conflict_reasons"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "accepted"
              }
            }
          },
          "then": {
            "properties": {
              "leading": {
                "const": "support"
              },
              "conflict_refs": {
                "maxItems": 0
              },
              "conflict_reasons": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "uncertain",
                  "insufficient"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "leading": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
    "Slot": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "contested",
            "uncertain",
            "insufficient"
          ]
        },
        "accepted_values": {
          "type": "array",
          "items": {},
          "minItems": 0
        },
        "candidate_projections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Projection"
          },
          "minItems": 0
        },
        "basis": {
          "$ref": "urn:kip:2.0:schema:projection#/$defs/ProjectionBasis"
        }
      },
      "required": [
        "status",
        "accepted_values",
        "candidate_projections",
        "basis"
      ],
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/Projection"
}
